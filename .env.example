# Copy to .env.local (never commit real values). See docs/25-deployment.md.

# AI provider (server-only keys; never prefix with NEXT_PUBLIC_).
# Default: Gemini, free tier. Get a key at https://aistudio.google.com/apikey
# (free-tier prompts may be used by Google to improve its products).
GEMINI_API_KEY=replace-me
# Optional: Claude (paid). Set ARCHIE_PROVIDER=anthropic to use it.
ANTHROPIC_API_KEY=
ARCHIE_PROVIDER=gemini

# Optional
# Model override. Defaults: gemini-3.8-flash (gemini), claude-opus-5-5 (anthropic)
ARCHIE_MODEL=
ARCHIE_DAILY_CAP=500
# Set only if the public demo is being abused (docs/18-authentication.md)
ARCHIE_ACCESS_CODE=
# Salt for hashing client IPs in the rate limiter (random per process if unset)
ARCHIE_IP_SALT=
ARCHIE_LOG_LEVEL=debug

# Canonical site URL for metadata and social previews (defaults to the Vercel production URL, then localhost)
NEXT_PUBLIC_SITE_URL=

# Evals against a deployed backend (docs/24-latency-benchmark.md)
EVAL_BASE_URL=
