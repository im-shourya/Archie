# Copy to .env.local (never commit real values). See docs/25-deployment.md.

# AI provider (server-only keys; never prefix with NEXT_PUBLIC_).
# Default: Gemini, free tier. Get a key at https://aistudio.google.com/apikey
# (free-tier prompts may be used by Google to improve its products).
GEMINI_API_KEY=replace-me
# Fallback when Gemini is rate-limited, overloaded or out of quota: Groq, free tier.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: Anthropic (paid). Set ARCHIE_PROVIDER=anthropic to use it.
ANTHROPIC_API_KEY=
# Primary: gemini | groq | anthropic. Fallback: groq (default when GROQ_API_KEY is set) | gemini | anthropic | none
ARCHIE_PROVIDER=gemini
ARCHIE_FALLBACK=

# Free-tier quota guards (ADR-017). Defaults sit just under each free tier; set them to the
# numbers on your own dashboards (aistudio.google.com/rate-limit, console.groq.com/settings/limits).
# Applied per model. Gemini defaults: 9 rpm, 19 rpd (the free tier measured 20/day per model; resets at
# midnight Pacific). Groq: 28 rpm, 950 rpd, 7600 tpm, 190000 tpd.
GEMINI_RPM=
GEMINI_RPD=
GROQ_RPM=
GROQ_RPD=
GROQ_TPM=
GROQ_TPD=

# Gemini model ladder, tried in order (each model has its own free quota)
GEMINI_MODELS=gemini-2.5-flash,gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.8-flash

# Optional
# Pin the primary to one model (disables the ladder). Defaults: see GEMINI_MODELS, openai/gpt-oss-120b (groq), ANTHROPIC_DEFAULT_MODEL (anthropic)
ARCHIE_MODEL=
ARCHIE_DAILY_CAP=500
# Set only if the public demo is being abused (docs/18-authentication.md)
ARCHIE_ACCESS_CODE=
# Salt for hashing client IPs in the rate limiter (random per process if unset)
ARCHIE_IP_SALT=
# Behind a host's proxy: the header it sets with the client's address (e.g. true-client-ip), so a
# client can't forge X-Forwarded-For to get a fresh rate-limit bucket. Unset locally.
ARCHIE_CLIENT_IP_HEADER=
# Only when ARCHIE_CLIENT_IP_HEADER=x-forwarded-for: how many proxies append to it (default 1)
ARCHIE_TRUSTED_PROXY_HOPS=
ARCHIE_LOG_LEVEL=debug

# Canonical site URL for metadata and social previews (defaults to the Vercel production URL, then localhost)
NEXT_PUBLIC_SITE_URL=

# Evals against a deployed backend (docs/24-latency-benchmark.md)
EVAL_BASE_URL=
