{
  "name": "archie",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Voice-first system-design board with a live simulator.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "simulator",
    "ai",
    "database",
    "backend",
    "frontend",
    "evals"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run build -w frontend",
    "start": "npm run start -w frontend",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench:fast": "tsx evals/src/bench/fastpath.ts",
    "bench:sim": "tsx evals/src/bench/simulator.ts",
    "eval": "tsx evals/src/run.ts",
    "bundle:size": "tsx scripts/bundle-size.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.3",
    "ajv": "^8.20.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
